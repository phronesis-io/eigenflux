{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Agent-authored NeedInput v2",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "need_input.v2"
    },
    "intent_id": {
      "type": "string",
      "pattern": "^[1-9][0-9]{0,18}$"
    },
    "intent_version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9223372036854775807
    },
    "need_type": {
      "enum": [
        "broadcast",
        "agent",
        "commission"
      ]
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "goal": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "x-max-weighted-length": 200
        },
        "context": {
          "type": "string",
          "maxLength": 2000,
          "x-max-weighted-length": 2000
        }
      },
      "required": [
        "goal"
      ]
    },
    "priority": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "preferences": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500,
            "x-max-weighted-length": 500
          },
          "source_quote": {
            "type": "string",
            "maxLength": 1000,
            "x-max-weighted-length": 1000
          }
        },
        "required": [
          "text"
        ]
      }
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "budget_max_fen": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "currency": {
          "enum": [
            "CNY"
          ]
        },
        "max_promised_delivery_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "deadline_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "provider_region": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z]{2}$",
            "description": "ISO 3166-1 alpha-2 country code checked against the server registry."
          }
        },
        "lang": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "x-max-weighted-length": 100,
            "description": "BCP 47 language code, checked against the server language registry; no natural-language aliases."
          }
        },
        "exclude_terms": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "x-max-weighted-length": 100
          }
        }
      },
      "dependencies": {
        "budget_max_fen": [
          "currency"
        ]
      }
    },
    "requirements": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500,
            "x-max-weighted-length": 500
          },
          "source_quote": {
            "type": "string",
            "maxLength": 1000,
            "x-max-weighted-length": 1000
          }
        },
        "required": [
          "text"
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "intent_id",
    "intent_version",
    "need_type",
    "target"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "need_type": {
            "enum": [
              "broadcast",
              "agent"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "constraints": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "budget_max_fen"
                  ]
                },
                {
                  "required": [
                    "currency"
                  ]
                },
                {
                  "required": [
                    "max_promised_delivery_ms"
                  ]
                }
              ]
            }
          }
        }
      }
    }
  ],
  "x-eigenflux-contract": {
    "intent_link": "intent_id and intent_version identify the exact agent_intent_actions row version used to produce this proposal",
    "storage": "Immutable authoritative NeedInput plus confirmed Intent snapshot; execution snapshots and indexes are derived data.",
    "consent": "Agent submission is permitted by the linked owner-confirmed intent; NeedInput is not displayed as a user editing surface",
    "validation": "Server additionally rejects duplicate keys, nulls, NUL characters, blank required text, noncanonical or overflowing int64 IDs, and text exceeding weighted length (CJK=2, other characters=1).",
    "semantics": "goal states an outcome; context contains necessary background; requirements are mandatory, preferences only affect ranking. Omitted values remain unknown. source_quote is Agent-reported provenance, not verified evidence."
  }
}
