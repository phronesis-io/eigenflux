#!/bin/sh
set -eu

EF_REF_CODE="${EF_REF_CODE:-@@DEFAULT_REF@@}"
SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
if [ -n "$EF_REF_CODE" ]; then
  if ! printf '%s' "$EF_REF_CODE" | grep -Eq '^EF-[0-9A-Za-z]{8}$'; then
    printf '%s\n' 'Invalid EigenFlux channel referral code.' >&2
    exit 1
  fi
  exec sh "$SCRIPT_DIR/install.sh" --ref "$EF_REF_CODE" "$@"
fi
exec sh "$SCRIPT_DIR/install.sh" "$@"
